# Mobile Environment Variables (Expo SDK 49+)
# Variables prefixed with EXPO_PUBLIC_ are available in code via process.env.EXPO_PUBLIC_*

# Optional: Override the backend API base URL.
# If not set, it automatically detects the host IP via Expo Metro Bundler.
# EXPO_PUBLIC_API_URL=http://10.59.60.162:8080/api/v1
