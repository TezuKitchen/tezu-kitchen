# === Database Configuration ===
DATABASE_URL=jdbc:postgresql://localhost:5432/tezukitchen
DATABASE_USERNAME=tezukitchen
DATABASE_PASSWORD=changeme

# === JWT Configuration ===
# Must be a valid Base64-encoded string of at least 256 bits.
# Generate one using: openssl rand -base64 64
JWT_SECRET=Y2hhbmdlbWVjaGFuZ2VtZWNoYW5nZW1lY2hhbmdlbWVjaGFuZ2VtZWNoYW5nZW1lY2hhbmdlbWVjaGFuZ2VtZQ==
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# === Server Configuration ===
SERVER_PORT=8080

# === Spring Profiles ===
SPRING_PROFILES_ACTIVE=dev

# === CORS Configuration ===
# Comma-separated list of allowed origins for CORS.
# For local development with Expo, use the Metro bundler URL.
# Example: http://localhost:8081,http://localhost:19006
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# === Razorpay Configuration ===
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
