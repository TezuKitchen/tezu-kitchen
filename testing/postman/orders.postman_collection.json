{
  "info": {
    "name": "TezuKitchen - Orders Test Suite",
    "description": "Comprehensive automated test collection for Orders API endpoints (/api/v1/orders) covering order creation, retrieval by user and restaurant, status progression (PLACED -> ACCEPTED -> PREPARING -> OUT_FOR_DELIVERY -> DELIVERED), invalid transitions, and access control.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "studentToken", "value": "" },
    { "key": "ownerToken", "value": "" },
    { "key": "otherStudentToken", "value": "" },
    { "key": "studentId", "value": "" },
    { "key": "ownerId", "value": "" },
    { "key": "restaurantId", "value": "" },
    { "key": "menuItemId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "nonExistentOrderId", "value": "e0000000-0000-0000-0000-000000000005" }
  ],
  "item": [
    {
      "name": "01. Setup - Register Student",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var json = pm.response.json();",
              "if (json.data) {",
              "    pm.collectionVariables.set(\"studentToken\", json.data.accessToken);",
              "    pm.collectionVariables.set(\"studentId\", json.data.userId);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Order Student\",\n  \"email\": \"order_student_{{$timestamp}}@tezu.ac.in\",\n  \"phone\": \"9876543240\",\n  \"password\": \"Pass12345!\",\n  \"role\": \"STUDENT\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
      }
    },
