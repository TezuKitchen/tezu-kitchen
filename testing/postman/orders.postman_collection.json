              "    pm.expect(jsonData.data).to.have.property(\"restaurantName\");",
              "    pm.expect(jsonData.data).to.have.property(\"deliveryAddress\");",
              "    pm.expect(jsonData.data).to.have.property(\"items\");",
              "});"
            ],
            "type": "text/javascript"
          }
