{
  "info": {
    "name": "TezuKitchen - Orders Test Suite",
    "description": "Automated test collection for Orders API endpoints (/api/v1/orders).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "studentToken", "value": "" },
    { "key": "ownerToken", "value": "" },
    { "key": "studentId", "value": "" },
    { "key": "restaurantId", "value": "" },
    { "key": "menuItemId", "value": "" },
    { "key": "orderId", "value": "" }
  ],
  "item": [
    {
      "name": "Create Order",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Response has correct structure\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.message).to.eql(\"Order placed successfully\");",
              "    pm.expect(jsonData.data).to.have.property(\"id\");",
              "    pm.expect(jsonData.data).to.have.property(\"totalAmount\");",
              "    pm.expect(jsonData.data).to.have.property(\"status\");",
              "    pm.expect(jsonData.data.status).to.eql(\"PLACED\");",
              "    pm.expect(jsonData.data.items).to.be.an(\"array\").that.is.not.empty;",
              "});",
              "pm.test(\"Extract orderId\", function () {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.data && jsonData.data.id) {",
              "        pm.collectionVariables.set(\"orderId\", jsonData.data.id);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }]
        },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"restaurantId\": \"{{restaurantId}}\",\n  \"deliveryAddress\": \"Hostel C, Room 101\",\n  \"items\": [\n    {\n      \"menuItemId\": \"{{menuItemId}}\",\n      \"quantity\": 2\n    }\n  ]\n}"
        },
        "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] }
      }
    },
    {
      "name": "Get Order By ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response has order details\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.message).to.eql(\"Order retrieved successfully\");",
              "    pm.expect(jsonData.data).to.have.property(\"id\");",
              "    pm.expect(jsonData.data).to.have.property(\"restaurantName\");",
              "    pm.expect(jsonData.data).to.have.property(\"deliveryAddress\");",
              "    pm.expect(jsonData.data).to.have.property(\"items\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }]
        },
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["orders", "{{orderId}}"] }
      }
    },
    {
      "name": "Get Orders By User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response has paginated content\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.data).to.have.property(\"content\");",
              "    pm.expect(jsonData.data.content).to.be.an(\"array\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }]
        },
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/orders/user/{{studentId}}", "host": ["{{baseUrl}}"], "path": ["orders", "user", "{{studentId}}"] }
      }
    },
    {
      "name": "Get Orders By Restaurant",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response has paginated content\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.data).to.have.property(\"content\");",
              "    pm.expect(jsonData.data.content).to.be.an(\"array\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }]
        },
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/orders/restaurant/{{restaurantId}}", "host": ["{{baseUrl}}"], "path": ["orders", "restaurant", "{{restaurantId}}"] }
      }
    },
    {
      "name": "Update Order Status (ACCEPTED)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Status updated to ACCEPTED\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.message).to.eql(\"Order status updated successfully\");",
              "    pm.expect(jsonData.data.status).to.eql(\"ACCEPTED\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }]
        },
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"ACCEPTED\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/orders/{{orderId}}/status", "host": ["{{baseUrl}}"], "path": ["orders", "{{orderId}}", "status"] }
      }
    },
