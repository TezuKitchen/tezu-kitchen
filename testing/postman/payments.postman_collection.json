          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }]
        },
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/payments/order/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["payments", "order", "{{orderId}}"] }
      }
