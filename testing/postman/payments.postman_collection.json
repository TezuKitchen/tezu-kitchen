        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"method\": \"COD\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] }
      }
    },
    {
      "name": "12. Get Payment By ID - Success as Ordering Student (Expect 200)",
      "event": [
