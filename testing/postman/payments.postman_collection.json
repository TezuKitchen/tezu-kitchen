    },
    {
      "name": "15. Get Payment By Order ID - Success (Expect 200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var json = pm.response.json();",
              "pm.expect(json.success).to.be.true;",
              "pm.expect(json.data.orderId).to.eql(pm.collectionVariables.get(\"orderId\"));"
