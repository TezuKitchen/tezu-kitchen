          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }]
        },
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/payments/order/{{nonExistentId}}", "host": ["{{baseUrl}}"], "path": ["payments", "order", "{{nonExistentId}}"] }
      }
