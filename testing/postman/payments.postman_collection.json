{
  "info": {
    "name": "TezuKitchen - Payments Test Suite",
    "description": "Comprehensive automated test collection for Payments API endpoints (/api/v1/payments) covering payment creation, payment method validation, ownership authorization, duplicate payment restrictions, and order-specific payment lookups.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "studentToken", "value": "" },
    { "key": "studentId", "value": "" },
    { "key": "otherStudentToken", "value": "" },
    { "key": "otherStudentId", "value": "" },
    { "key": "ownerToken", "value": "" },
    { "key": "ownerId", "value": "" },
    { "key": "restaurantId", "value": "" },
    { "key": "menuItemId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "paymentId", "value": "" },
    { "key": "nonExistentId", "value": "c0000000-0000-0000-0000-000000000003" }
  ],
  "item": [
    {
      "name": "01. Setup - Register Student",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var json = pm.response.json();",
              "if (json.data) {",
              "    pm.collectionVariables.set(\"studentToken\", json.data.accessToken);",
              "    pm.collectionVariables.set(\"studentId\", json.data.userId);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Payment Student\",\n  \"email\": \"pay_student_{{$timestamp}}@tezu.ac.in\",\n  \"phone\": \"9876543220\",\n  \"password\": \"Pass12345!\",\n  \"role\": \"STUDENT\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
      }
    },
    {
      "name": "02. Setup - Register Other Student",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var json = pm.response.json();",
              "if (json.data) {",
              "    pm.collectionVariables.set(\"otherStudentToken\", json.data.accessToken);",
              "    pm.collectionVariables.set(\"otherStudentId\", json.data.userId);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Other Student\",\n  \"email\": \"other_student_{{$timestamp}}@tezu.ac.in\",\n  \"phone\": \"9876543221\",\n  \"password\": \"Pass12345!\",\n  \"role\": \"STUDENT\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
      }
    },
    {
      "name": "03. Setup - Register Owner",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
