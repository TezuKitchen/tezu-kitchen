{
  "info": {
    "name": "TezuKitchen - Restaurants Test Suite",
    "description": "Comprehensive automated test collection for Restaurants API endpoints (/api/v1/restaurants) covering restaurant creation, public retrieval, owner filters, update validations, ownership permissions, and deletion.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "ownerToken", "value": "" },
    { "key": "ownerId", "value": "" },
    { "key": "studentToken", "value": "" },
    { "key": "studentId", "value": "" },
    { "key": "restaurantId", "value": "" },
    { "key": "nonExistentRestaurantId", "value": "b0000000-0000-0000-0000-000000000002" }
  ],
  "item": [
    {
      "name": "01. Setup - Register Owner User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var json = pm.response.json();",
              "if (json.data) {",
              "    pm.collectionVariables.set(\"ownerToken\", json.data.accessToken);",
              "    pm.collectionVariables.set(\"ownerId\", json.data.userId);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Chef Owner\",\n  \"email\": \"owner_{{$timestamp}}@tezu.ac.in\",\n  \"phone\": \"9876543211\",\n  \"password\": \"OwnerPass123!\",\n  \"role\": \"OWNER\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
      }
    },
    {
      "name": "02. Setup - Register Student User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var json = pm.response.json();",
              "if (json.data) {",
              "    pm.collectionVariables.set(\"studentToken\", json.data.accessToken);",
              "    pm.collectionVariables.set(\"studentId\", json.data.userId);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Student Customer\",\n  \"email\": \"student_{{$timestamp}}@tezu.ac.in\",\n  \"phone\": \"9876543212\",\n  \"password\": \"StudentPass123!\",\n  \"role\": \"STUDENT\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
      }
    },
    {
      "name": "03. Create Restaurant - Unauthorized (Expect 401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 401 Unauthorized\", function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Campus Diner\",\n  \"description\": \"Great north indian food\",\n  \"location\": \"SAC Building Ground Floor\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/restaurants", "host": ["{{baseUrl}}"], "path": ["restaurants"] }
      }
    },
    {
      "name": "04. Create Restaurant - Validation Error Blank Fields (Expect 400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400 Bad Request\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "var json = pm.response.json();",
              "pm.expect(json.status).to.eql(400);",
              "pm.expect(json.errors).to.be.an(\"array\").that.is.not.empty;"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }]
        },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\",\n  \"description\": \"\",\n  \"location\": \"\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/restaurants", "host": ["{{baseUrl}}"], "path": ["restaurants"] }
      }
    },
    {
      "name": "05. Create Restaurant - Success as Owner (Expect 201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var json = pm.response.json();",
              "pm.expect(json.success).to.be.true;",
              "pm.expect(json.data).to.have.property(\"id\");",
              "pm.expect(json.data.name).to.eql(\"Campus Cafe\");",
              "pm.collectionVariables.set(\"restaurantId\", json.data.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }]
        },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Campus Cafe\",\n  \"description\": \"Quick bites and drinks\",\n  \"location\": \"Student Activity Center\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/restaurants", "host": ["{{baseUrl}}"], "path": ["restaurants"] }
      }
    },
    {
      "name": "06. List Restaurants - Public Access (Expect 200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var json = pm.response.json();",
              "pm.expect(json.success).to.be.true;",
              "pm.expect(json.data).to.have.property(\"content\");",
              "pm.expect(json.data.content).to.be.an(\"array\");"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/restaurants?page=0&size=10", "host": ["{{baseUrl}}"], "path": ["restaurants"], "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "10" }] }
      }
    },
    {
      "name": "07. Get Restaurant By ID - Success (Expect 200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var json = pm.response.json();",
              "pm.expect(json.success).to.be.true;",
              "pm.expect(json.data.id).to.eql(pm.collectionVariables.get(\"restaurantId\"));",
              "pm.expect(json.data.name).to.eql(\"Campus Cafe\");"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/restaurants/{{restaurantId}}", "host": ["{{baseUrl}}"], "path": ["restaurants", "{{restaurantId}}"] }
      }
    },
    {
      "name": "08. Get Restaurant By ID - Not Found (Expect 404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 404 Not Found\", function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "var json = pm.response.json();",
              "pm.expect(json.status).to.eql(404);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/restaurants/{{nonExistentRestaurantId}}", "host": ["{{baseUrl}}"], "path": ["restaurants", "{{nonExistentRestaurantId}}"] }
      }
    },
    {
      "name": "09. Get Restaurants By Owner - Success (Expect 200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var json = pm.response.json();",
              "pm.expect(json.success).to.be.true;",
              "pm.expect(json.data).to.be.an(\"array\").that.is.not.empty;"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/restaurants/owner/{{ownerId}}", "host": ["{{baseUrl}}"], "path": ["restaurants", "owner", "{{ownerId}}"] }
      }
    },
    {
      "name": "10. Update Restaurant - Validation Failure (Expect 400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400 Bad Request\", function () {",
              "    pm.response.to.have.status(400);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }]
        },
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\",\n  \"location\": \"\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/restaurants/{{restaurantId}}", "host": ["{{baseUrl}}"], "path": ["restaurants", "{{restaurantId}}"] }
      }
    },
    {
      "name": "11. Update Restaurant - Forbidden Non-Owner (Expect 403)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 403 Forbidden\", function () {",
              "    pm.response.to.have.status(403);",
              "});",
              "var json = pm.response.json();",
              "pm.expect(json.message).to.include(\"not the owner\");"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }]
        },
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Unauthorized Rename\",\n  \"location\": \"Somewhere Else\",\n  \"isOpen\": false\n}"
        },
        "url": { "raw": "{{baseUrl}}/restaurants/{{restaurantId}}", "host": ["{{baseUrl}}"], "path": ["restaurants", "{{restaurantId}}"] }
      }
    },
    {
      "name": "12. Update Restaurant - Success as Owner (Expect 200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var json = pm.response.json();",
              "pm.expect(json.success).to.be.true;",
              "pm.expect(json.data.name).to.eql(\"Campus Cafe Deluxe\");",
              "pm.expect(json.data.open).to.eql(false);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }]
        },
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Campus Cafe Deluxe\",\n  \"description\": \"Expanded menu and breakfast\",\n  \"location\": \"SAC 1st Floor\",\n  \"isOpen\": false\n}"
        },
        "url": { "raw": "{{baseUrl}}/restaurants/{{restaurantId}}", "host": ["{{baseUrl}}"], "path": ["restaurants", "{{restaurantId}}"] }
      }
    },
    {
      "name": "13. Delete Restaurant - Forbidden Non-Owner (Expect 403)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 403 Forbidden\", function () {",
              "    pm.response.to.have.status(403);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }]
        },
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{baseUrl}}/restaurants/{{restaurantId}}", "host": ["{{baseUrl}}"], "path": ["restaurants", "{{restaurantId}}"] }
      }
    },
    {
      "name": "14. Delete Restaurant - Success as Owner (Expect 204)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 204 No Content\", function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }]
        },
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{baseUrl}}/restaurants/{{restaurantId}}", "host": ["{{baseUrl}}"], "path": ["restaurants", "{{restaurantId}}"] }
      }
    },
    {
      "name": "15. Get Deleted Restaurant (Expect 404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 404 Not Found\", function () {",
              "    pm.response.to.have.status(404);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/restaurants/{{restaurantId}}", "host": ["{{baseUrl}}"], "path": ["restaurants", "{{restaurantId}}"] }
      }
    }
  ]
}
