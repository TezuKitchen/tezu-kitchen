{
  "info": {
    "name": "TezuKitchen - Auth Test Suite",
    "description": "Comprehensive automated test suite for Auth endpoints (Register, Login, Refresh, Logout) covering all validation errors, authentication failures, single-use token rotation, replay attacks, and token revocation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "dynamicEmail", "value": "" },
    { "key": "dynamicPassword", "value": "StrongPass123!" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "oldRotatedRefreshToken", "value": "" },
    { "key": "userId", "value": "" }
  ],
