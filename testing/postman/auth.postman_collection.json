    {
      "name": "06. Register - Happy Path (Expect 201 Created & Auto-Save Tokens)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const uniqueSuffix = Date.now() + \"_\" + Math.floor(Math.random() * 1000);",
              "const email = `student_${uniqueSuffix}@tezukitchen.com`;",
              "pm.collectionVariables.set(\"dynamicEmail\", email);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "pm.test(\"Response contains tokens and user metadata\", function () {",
              "    pm.expect(json.success).to.be.true;",
              "    pm.expect(json.data.accessToken).to.be.a('string').that.is.not.empty;",
              "    pm.expect(json.data.refreshToken).to.be.a('string').that.is.not.empty;",
              "    pm.expect(json.data.tokenType).to.eql('Bearer');",
              "    pm.expect(json.data.userId).to.be.a('string');",
              "});",
              "pm.collectionVariables.set(\"accessToken\", json.data.accessToken);",
              "pm.collectionVariables.set(\"refreshToken\", json.data.refreshToken);",
              "pm.collectionVariables.set(\"userId\", json.data.userId);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Alice Walker\",\n  \"email\": \"{{dynamicEmail}}\",\n  \"phone\": \"9876543210\",\n  \"password\": \"{{dynamicPassword}}\",\n  \"role\": \"STUDENT\"\n}"
