{
  "info": {
    "name": "TezuKitchen - Menu Test Suite",
    "description": "Comprehensive automated test collection for Menu API endpoints (/api/v1/menu) covering item creation, validation, availability filtering, restaurant-specific queries, updates, ownership access control, and deletion.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "token", "value": "" },
    { "key": "ownerId", "value": "" },
    { "key": "studentToken", "value": "" },
    { "key": "restaurantId", "value": "" },
    { "key": "menuItemId", "value": "" },
    { "key": "nonExistentMenuItemId", "value": "d0000000-0000-0000-0000-000000000004" }
  ],
  "item": [
    {
      "name": "01. Setup - Register Owner",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var json = pm.response.json();",
              "if (json.data) {",
              "    pm.collectionVariables.set(\"token\", json.data.accessToken);",
              "    pm.collectionVariables.set(\"ownerId\", json.data.userId);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Menu Chef\",\n  \"email\": \"menu_owner_{{$timestamp}}@tezu.ac.in\",\n  \"phone\": \"9876543230\",\n  \"password\": \"Pass12345!\",\n  \"role\": \"OWNER\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
      }
    },
    {
      "name": "02. Setup - Create Restaurant",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var json = pm.response.json();",
              "if (json.data) {",
              "    pm.collectionVariables.set(\"restaurantId\", json.data.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Spice Kitchen\",\n  \"description\": \"Spicy and aromatic\",\n  \"location\": \"Food Court\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/restaurants", "host": ["{{baseUrl}}"], "path": ["restaurants"] }
      }
    },
    {
      "name": "03. Setup - Register Student",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var json = pm.response.json();",
              "if (json.data) {",
              "    pm.collectionVariables.set(\"studentToken\", json.data.accessToken);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Menu Student\",\n  \"email\": \"menu_student_{{$timestamp}}@tezu.ac.in\",\n  \"phone\": \"9876543231\",\n  \"password\": \"Pass12345!\",\n  \"role\": \"STUDENT\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
      }
    },
    {
      "name": "04. Create Menu Item - Unauthorized (Expect 401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 401\", function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"restaurantId\": \"{{restaurantId}}\",\n  \"name\": \"Butter Chicken\",\n  \"price\": 250.00,\n  \"category\": \"Main Course\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/menu", "host": ["{{baseUrl}}"], "path": ["menu"] }
      }
    },
    {
      "name": "05. Create Menu Item - Validation Error (Expect 400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "var json = pm.response.json();",
              "pm.expect(json.status).to.eql(400);",
              "pm.expect(json.errors).to.be.an(\"array\").that.is.not.empty;"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"restaurantId\": null,\n  \"name\": \"\",\n  \"price\": -50.00,\n  \"category\": \"\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/menu", "host": ["{{baseUrl}}"], "path": ["menu"] }
      }
    },
    {
      "name": "06. Create Menu Item - Forbidden Non-Owner (Expect 403)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 403\", function () {",
              "    pm.response.to.have.status(403);",
              "});",
              "var json = pm.response.json();",
              "pm.expect(json.message).to.include(\"not the owner\");"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }]
        },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"restaurantId\": \"{{restaurantId}}\",\n  \"name\": \"Unauthorized Dish\",\n  \"price\": 100.00,\n  \"category\": \"Snacks\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/menu", "host": ["{{baseUrl}}"], "path": ["menu"] }
      }
    },
    {
      "name": "Create Menu Item",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Extract menuItemId\", function () {",
              "    var jsonData = pm.response.json();",
              "    if(jsonData.data && jsonData.data.id) {",
              "        pm.collectionVariables.set(\"menuItemId\", jsonData.data.id);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ]
        },
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"restaurantId\": \"{{restaurantId}}\",\n  \"name\": \"Butter Chicken\",\n  \"description\": \"Creamy curry dish\",\n  \"price\": 250.00,\n  \"category\": \"Main Course\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/menu", "host": [ "{{baseUrl}}" ], "path": [ "menu" ] }
      }
    },
    {
      "name": "Get Menu Item By ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var json = pm.response.json();",
              "pm.expect(json.data.name).to.eql(\"Butter Chicken\");"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/menu/{{menuItemId}}", "host": [ "{{baseUrl}}" ], "path": [ "menu", "{{menuItemId}}" ] }
      }
    },
    {
      "name": "Get Menu Item By ID - Not Found (Expect 404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 404\", function () {",
              "    pm.response.to.have.status(404);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/menu/{{nonExistentMenuItemId}}", "host": [ "{{baseUrl}}" ], "path": [ "menu", "{{nonExistentMenuItemId}}" ] }
      }
    },
    {
      "name": "Get Menu Items By Restaurant",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var json = pm.response.json();",
              "pm.expect(json.data).to.be.an(\"array\").that.is.not.empty;"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/menu/restaurant/{{restaurantId}}", "host": [ "{{baseUrl}}" ], "path": [ "menu", "restaurant", "{{restaurantId}}" ] }
      }
    },
    {
      "name": "Get Available Menu Items",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var json = pm.response.json();",
              "pm.expect(json.data).to.be.an(\"array\");"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/menu/restaurant/{{restaurantId}}/available", "host": [ "{{baseUrl}}" ], "path": [ "menu", "restaurant", "{{restaurantId}}", "available" ] }
      }
    },
    {
      "name": "Update Menu Item - Forbidden Non-Owner (Expect 403)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 403\", function () {",
              "    pm.response.to.have.status(403);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }]
        },
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Tampered Name\",\n  \"price\": 10.00,\n  \"isAvailable\": true,\n  \"category\": \"Main Course\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/menu/{{menuItemId}}", "host": ["{{baseUrl}}"], "path": ["menu", "{{menuItemId}}"] }
      }
    },
    {
      "name": "Update Menu Item",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var json = pm.response.json();",
              "pm.expect(json.data.name).to.eql(\"Butter Chicken Special\");",
              "pm.expect(json.data.price).to.eql(300.00);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ]
        },
        "method": "PUT",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Butter Chicken Special\",\n  \"description\": \"Extra creamy version\",\n  \"price\": 300.00,\n  \"isAvailable\": true,\n  \"category\": \"Specials\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/menu/{{menuItemId}}", "host": [ "{{baseUrl}}" ], "path": [ "menu", "{{menuItemId}}" ] }
      }
    },
    {
      "name": "Delete Menu Item - Forbidden Non-Owner (Expect 403)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 403\", function () {",
              "    pm.response.to.have.status(403);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }]
        },
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{baseUrl}}/menu/{{menuItemId}}", "host": ["{{baseUrl}}"], "path": ["menu", "{{menuItemId}}"] }
      }
    },
    {
      "name": "Delete Menu Item",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 204\", function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ]
        },
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{baseUrl}}/menu/{{menuItemId}}", "host": [ "{{baseUrl}}" ], "path": [ "menu", "{{menuItemId}}" ] }
      }
    },
    {
      "name": "Get Deleted Menu Item (Expect 404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 404\", function () {",
              "    pm.response.to.have.status(404);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/menu/{{menuItemId}}", "host": ["{{baseUrl}}"], "path": ["menu", "{{menuItemId}}"] }
      }
    }
  ]
}
