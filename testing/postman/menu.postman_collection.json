{
  "info": {
    "name": "TezuKitchen - Menu Test Suite",
    "description": "Automated test collection for Menu API endpoints (/api/v1/menu).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "token", "value": "" },
    { "key": "restaurantId", "value": "" },
    { "key": "menuItemId", "value": "" }
  ],
  "item": [
    {
      "name": "Create Menu Item",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Extract menuItemId\", function () {",
              "    var jsonData = pm.response.json();",
              "    if(jsonData.data && jsonData.data.id) {",
              "        pm.collectionVariables.set(\"menuItemId\", jsonData.data.id);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ]
        },
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"restaurantId\": \"{{restaurantId}}\",\n  \"name\": \"Butter Chicken\",\n  \"description\": \"Creamy curry dish\",\n  \"price\": 250.00,\n  \"category\": \"Main Course\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/menu", "host": [ "{{baseUrl}}" ], "path": [ "menu" ] }
      }
    },
    {
      "name": "Get Menu Item By ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/menu/{{menuItemId}}", "host": [ "{{baseUrl}}" ], "path": [ "menu", "{{menuItemId}}" ] }
      }
    },
    {
      "name": "Get Menu Items By Restaurant",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/menu/restaurant/{{restaurantId}}", "host": [ "{{baseUrl}}" ], "path": [ "menu", "restaurant", "{{restaurantId}}" ] }
      }
    },
    {
      "name": "Get Available Menu Items",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/menu/restaurant/{{restaurantId}}/available", "host": [ "{{baseUrl}}" ], "path": [ "menu", "restaurant", "{{restaurantId}}", "available" ] }
      }
    },
    {
      "name": "Update Menu Item",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ]
        },
        "method": "PUT",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Butter Chicken Special\",\n  \"description\": \"Extra creamy version\",\n  \"price\": 300.00,\n  \"isAvailable\": true,\n  \"category\": \"Specials\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/menu/{{menuItemId}}", "host": [ "{{baseUrl}}" ], "path": [ "menu", "{{menuItemId}}" ] }
      }
    },
    {
      "name": "Delete Menu Item",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 204\", function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ]
        },
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{baseUrl}}/menu/{{menuItemId}}", "host": [ "{{baseUrl}}" ], "path": [ "menu", "{{menuItemId}}" ] }
      }
    }
  ]
}
